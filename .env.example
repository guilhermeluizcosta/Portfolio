# Chat assistant (portfolioai)
# Development: http://localhost:8080/api/v1/chat
# Production: published API URL (does not need to match the local path)
CHAT_API_URL=http://localhost:8080/api/v1/chat

# Questions allowed per visitor in this browser (between 5 and 10)
CHAT_QUESTION_LIMIT=7

# First reply can be slow while the API wakes up (milliseconds)
CHAT_REQUEST_TIMEOUT_MS=120000

CHAT_MAX_QUESTION_LENGTH=1000
